    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "codemirror": "^6.0.2",
    "cytoscape": "^3.34.1",
    "cytoscape-edgehandles": "^4.0.1",
    "cytoscape-fcose": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",

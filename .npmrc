# Takumi Guard (Shisho) supply-chain proxy.
# Only the registry lives here - the auth token must never be committed.
# Supply it per developer / per CI, e.g.
#   pnpm config set //npm.flatt.tech/:_authToken "$TAKUMI_GUARD_TOKEN"
# Without a token the proxy still runs in anonymous mode and blocked packages
# are rejected with 403.
registry=https://npm.flatt.tech/
